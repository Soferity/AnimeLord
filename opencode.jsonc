{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "browser": {
        "type": "local",
        "command": [
          "bun",
          "run",
          "E:/MyProject/Mix/browser-mcp/mcp-server/src/index.ts"
        ],
        "environment": {
          "BROWSER": "chrome",
          "BROWSER_MCP_PORT": "8765"
        }
      }
    }
  },
  "shell": "pwsh",
  "provider": {
    "opencode": {
      "options": {
        "baseURL": "https://opencode.ai/zen/v1"
      }
    }
  }
}